{
  "entities": {
    "Beat": {
      "title": "Beat Entity",
      "description": "Represents a single musical track (beat) available for license.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 100 },
        "producerId": { "type": "string" },
        "bpm": { "type": "integer" },
        "key": { "type": "string", "pattern": "^[A-G][#b]? (major|minor)$" },
        "genre": { "type": "string" },
        "subgenre": { "type": "string" },
        "tags": { "type": "array", "maxLength": 10 },
        "description": { "type": "string", "maxLength": 1000 },
        "audioUrl": { "type": "string", "format": "uri" },
        "artworkUrl": { "type": "string", "format": "uri" },
        "isFree": { "type": "boolean" },
        "payhipProductId": { "type": "string" },
        "payhipCheckoutUrl": { "type": "string", "format": "uri" },
        "licenses": {
          "type": "object",
          "properties": {
            "basic": { "type": "number" },
            "premium": { "type": "number" },
            "unlimited": { "type": "number" },
            "exclusive": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "published": { "type": "boolean" }
      },
      "required": ["title", "audioUrl", "producerId"]
    },
    "AnalyticsEvent": {
      "title": "Analytics Event",
      "description": "Real-time store event tracking record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string", "enum": ["play", "page_view", "cart_add", "checkout_completed", "free_download", "vr_view"] },
        "beatId": { "type": "string" },
        "beatTitle": { "type": "string" },
        "amount": { "type": "number" },
        "country": { "type": "string" },
        "device": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Order": {
      "title": "Order Ledger Entry",
      "description": "Real store purchase transaction record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerEmail": { "type": "string" },
        "beatId": { "type": "string" },
        "beatTitle": { "type": "string" },
        "licenseType": { "type": "string" },
        "amount": { "type": "number" },
        "paymentGateway": { "type": "string" },
        "status": { "type": "string" },
        "downloadKey": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "Subscriber": {
      "title": "Lead Subscriber",
      "description": "Email captured from free beat downloads and newsletter gates.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "beatId": { "type": "string" },
        "beatTitle": { "type": "string" },
        "source": { "type": "string" },
        "storefrontUrl": { "type": "string" },
        "beatUrl": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "VRReview": {
      "title": "VR Review Entity",
      "description": "Real-life VR studio headset listening review and spatial evaluation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "beatId": { "type": "string" },
        "beatTitle": { "type": "string" },
        "reviewerName": { "type": "string" },
        "rating": { "type": "number" },
        "vrHeadsetModel": { "type": "string" },
        "environmentName": { "type": "string" },
        "spatialAudioScore": { "type": "number" },
        "bassClarityScore": { "type": "number" },
        "reviewText": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "User": {
      "title": "User Profile",
      "description": "Extended user data for customers and producers.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["producer", "customer", "manager", "curator", "label", "engineer"] },
        "purchasedBeatIds": { "type": "array" },
        "favoriteBeatIds": { "type": "array" },
        "displayName": { "type": "string" }
      }
    },
    "BeatPack": {
      "title": "Beat Pack Entity",
      "description": "Represents a collection/bundle of beats available for download.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "artworkUrl": { "type": "string", "format": "uri" },
        "beatIds": { "type": "array" },
        "price": { "type": "number" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "zipUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "price"]
    },
    "Producer": {
      "title": "Producer Profile",
      "description": "Stores PayPal marketplace connection status and merchant information.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "paypalMerchantId": { "type": "string" },
        "trackingId": { "type": "string" },
        "onboardingStatus": { "type": "string", "enum": ["NOT_CONNECTED", "PENDING", "CONNECTED"] },
        "onboardingUrl": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "onboardingStatus"]
    },
    "Placement": {
      "title": "Placement Credit",
      "description": "Documented music placement credit for KRAEZELV.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "artistName": { "type": "string", "maxLength": 100 },
        "songTitle": { "type": "string", "maxLength": 100 },
        "albumTitle": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "format": "uri" },
        "streamUrl": { "type": "string", "format": "uri" },
        "releaseYear": { "type": "string" },
        "certifiedStreams": { "type": "string" },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["artistName", "songTitle"]
    },
    "CuratedCollection": {
      "title": "Curated Playlist Collection",
      "description": "Owner-curated playlist of beats.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "coverUrl": { "type": "string", "format": "uri" },
        "beatIds": { "type": "array" },
        "featured": { "type": "boolean" },
        "displayOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title"]
    },
    "VerifiedReview": {
      "title": "Verified Customer Review",
      "description": "Moderated review submitted by verified beat purchasers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "beatId": { "type": "string" },
        "beatTitle": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "integer" },
        "reviewText": { "type": "string", "maxLength": 1000 },
        "verifiedPurchase": { "type": "boolean" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["beatId", "customerEmail", "rating", "reviewText"]
    }
  },
  "firestore": {
    "/beats/{beatId}": {
      "schema": "Beat",
      "description": "Public catalog of available beats."
    },
    "/beat_packs/{packId}": {
      "schema": "BeatPack",
      "description": "Public catalog of available beat packs and bundles."
    },
    "/placements/{placementId}": {
      "schema": "Placement",
      "description": "Documented KRAEZELV industry placement credits."
    },
    "/curated_collections/{collectionId}": {
      "schema": "CuratedCollection",
      "description": "Owner-curated playlist collections."
    },
    "/verified_reviews/{reviewId}": {
      "schema": "VerifiedReview",
      "description": "Moderated verified buyer reviews."
    },
    "/producers/{userId}": {
      "schema": "Producer",
      "description": "Stores PayPal seller marketplace connection status."
    },
    "/analytics_events/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Store real-time analytics events."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store transactions and sales ledger."
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Captured newsletter leads and free download subscriber records."
    },
    "/vr_reviews/{reviewId}": {
      "schema": "VRReview",
      "description": "Real-life VR studio reviews and spatial audio feedback."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profiles and libraries."
    }
  }
}
