rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isProducer() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'producer';
    }

    // Beats Collection
    match /beats/{beatId} {
      allow read: if true; // Public catalog
      allow create, update, delete: if isProducer();
    }

    // BeatPacks Collection
    match /beatPacks/{packId} {
      allow read: if true;
      allow create, update, delete: if isProducer();
    }

    // Collections
    match /collections/{colId} {
      allow read: if true;
      allow create, update, delete: if isProducer();
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isProducer();
      allow write: if isOwner(userId);
    }
  }
}
