rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Beats Collection
    match /beats/{beatId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Beat Packs Collection
    match /beat_packs/{packId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    // Producers Collection (Marketplace Marketplace connection)
    match /producers/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Trusted server-side only
    }

    // Analytics Events Collection
    match /analytics_events/{eventId} {
      allow read: if isSignedIn();
      allow create: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create, update: if true;
    }

    // Subscribers Collection (Lead Generation / Free Downloads)
    match /subscribers/{subscriberId} {
      allow read: if isSignedIn();
      allow create: if true;
    }

    // VR Reviews Collection
    match /vr_reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isSignedIn();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
  }
}
