rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Beats Collection
    match /beats/{beatId} {
      allow read, write: if true;
    }

    // Beat Packs Collection
    match /beat_packs/{packId} {
      allow read, write: if true;
    }

    // Producers Collection
    match /producers/{userId} {
      allow read, write: if true;
    }

    // Analytics Events Collection
    match /analytics_events/{eventId} {
      allow read, write: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Subscribers Collection (Lead Generation / Free Downloads)
    match /subscribers/{subscriberId} {
      allow read, write: if true;
    }

    // VR Reviews Collection
    match /vr_reviews/{reviewId} {
      allow read, write: if true;
    }

    // Placements Collection (Industry Credits)
    match /placements/{placementId} {
      allow read, write: if true;
    }

    // Curated Collections
    match /curated_collections/{collectionId} {
      allow read, write: if true;
    }

    // Verified Reviews Collection
    match /verified_reviews/{reviewId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
